# Maintainer: not-koushi
pkgname=timbredrop
pkgver=0.1.4
pkgrel=1
pkgdesc='Minimal cross-platform YouTube audio-to-MP3 CLI'
arch=('any')
url='https://github.com/not-koushi/timbredrop'
license=('MIT')
depends=('python>=3.11' 'python-platformdirs' 'yt-dlp' 'ffmpeg' 'deno')
makedepends=('python-build' 'python-installer' 'python-setuptools')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::https://github.com/not-koushi/timbredrop/archive/refs/tags/v${pkgver}.tar.gz")
# TEMPORARY for the first package build. Replace SKIP with the verified source
# archive SHA-256 before submitting this recipe to the AUR.
sha256sums=('ef8f2b9f033697a33d0783c4b17bc1dc3f1176baed7a3a8b93f21104bf7629a0')

build() {
  cd "$srcdir/timbredrop-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/timbredrop-$pkgver"
  PYTHONPATH="$PWD/src" python -m pytest -q
}

package() {
  cd "$srcdir/timbredrop-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_NOTICES.md"
}
